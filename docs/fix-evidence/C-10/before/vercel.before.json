{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(self), microphone=(self), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/trains/by-station",
      "destination": "/api/trains/live-station"
    },
    {
      "source": "/api/recovery/:path*",
      "destination": "/api/recovery"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/assistant.js": {
      "maxDuration": 60
    },
    "api/translate.js": {
      "maxDuration": 60
    },
    "api/voice/transcribe.js": {
      "maxDuration": 60
    }
  }
}

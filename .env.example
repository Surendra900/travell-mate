# TravelMate AI - Environment Variables Template
# Copy this file to .env.local and fill in your keys as needed.
# Server-side secrets must never use the VITE_ prefix.

# Authentication (Clerk - Optional)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

API_REQUIRE_AUTH=false
CLERK_ISSUER_URL=
CLERK_JWT_ISSUER=
CLERK_AUDIENCE=
ALLOWED_ORIGINS=

# AI Assistant & Dynamic Translation (SambaNova - Optional)
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_ASSISTANT_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_FALLBACK_MODEL=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_TRANSLATION_MODEL=gpt-oss-120b
SAMBANOVA_AUDIO_API_KEY=
SAMBANOVA_AUDIO_BASE_URL=
SAMBANOVA_TRANSCRIBE_MODEL=Whisper-Large-v3

# Railway Provider (RapidAPI IRCTC - Optional for live queries)
RAPIDAPI_KEY=
RAPIDAPI_TRAIN_HOST=irctc1.p.rapidapi.com
RAPIDAPI_PNR_KEY=
RAPIDAPI_PNR_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
RAPIDAPI_PNR_ENDPOINT=/getPNRStatus/{pnr}

# Flight Provider (Skyscanner via RapidAPI / Aviationstack - Optional)
RAPIDAPI_FLIGHT_HOST=skyscanner-flights4.p.rapidapi.com
RAPIDAPI_FLIGHT_KEY=
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# Bus Provider Adapter (Optional)
BUS_API_URL=
BUS_API_KEY=
BUS_API_ALLOWED_HOSTS=

# Rate Limiting & Cache (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Routing & Maps (Optional)
OPENROUTESERVICE_KEY=
DATABASE_URL=
DIRECT_URL=
NODE_ENV=development

# Cloud Database Sync (Supabase - Optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (Route parsing & voice assistant - Optional)
VITE_GEMINI_API_KEY=

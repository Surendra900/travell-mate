// TravelMate Prisma Schema
// Aligned with Section 10 of MASTER_SPEC.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Station {
  code      String      @id
  name      String
  city      String
  state     String?
  latitude  Float
  longitude Float
  stops     TrainStop[]
  junction  Junction?   @relation(fields: [code], references: [stationCode])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([city])
}

model Train {
  number      String      @id
  name        String
  type        String      // Express, Superfast, Rajdhani, Vande Bharat
  originCode  String
  destCode    String
  runsOnDays  String      // "1111111" or "M,T,W,Th,F,Sa,Su"
  stops       TrainStop[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model TrainStop {
  id           String   @id @default(uuid())
  trainNumber  String
  stationCode  String
  stopSequence Int
  arrivalTime  String?  // HH:MM
  departTime   String?  // HH:MM
  dayCount     Int      @default(1)
  distanceKm   Float?
  train        Train    @relation(fields: [trainNumber], references: [number], onDelete: Cascade)
  station      Station  @relation(fields: [stationCode], references: [code])

  @@unique([trainNumber, stopSequence])
  @@index([stationCode])
  @@index([trainNumber])
}

model Junction {
  id               String          @id @default(uuid())
  stationCode      String          @unique
  cityName         String
  transferScore    Float           @default(80.0) // Efficiency metric
  station          Station         @relation
  transferGuides   TransferGuide[]
  createdAt        DateTime        @default(now())
}

model Terminal {
  id             String          @id @default(uuid())
  name           String
  city           String
  type           String          // "ISBT", "State Roadways", "Private Terminal"
  latitude       Float
  longitude      Float
  transferGuides TransferGuide[]
  createdAt      DateTime        @default(now())
}

model Airport {
  iataCode       String          @id
  name           String
  city           String
  latitude       Float
  longitude      Float
  transferGuides TransferGuide[]
  createdAt      DateTime        @default(now())
}

model TransferGuide {
  id                String    @id @default(uuid())
  junctionId        String
  terminalId        String?
  airportCode       String?
  transferMode      String    // "walk", "auto", "taxi", "metro"
  distanceKm        Float
  approxMinutes     Int
  approxCostInr     Float?
  guidanceText      String
  junction          Junction  @relation(fields: [junctionId], references: [id])
  terminal          Terminal? @relation(fields: [terminalId], references: [id])
  airport           Airport?  @relation(fields: [airportCode], references: [iataCode])
  createdAt         DateTime  @default(now())

  @@index([junctionId])
}

model ApiCache {
  key       String   @id
  provider  String
  payload   String   // JSON stringified payload
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Feedback {
  id        String   @id @default(uuid())
  rating    Int
  category  String   // "route_accuracy", "timing", "ui", "suggestion"
  comment   String?
  createdAt DateTime @default(now())
}
